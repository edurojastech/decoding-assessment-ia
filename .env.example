# Copie para .env (local) ou configure como Secrets no Replit.

# Porta do servidor (o Replit define automaticamente)
PORT=3000

# Postgres (Replit). Sem esta variável, usa SQLite em server/data/dev.sqlite
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# Obrigatório em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Administrador criado pelo seed
ADMIN_EMAIL=admin@decoding.demo
ADMIN_PASSWORD=decoding-demo

# Endereço público dos links pessoais (/r/:token). Sem esta variável, usa o endereço acessado pelo admin
# PUBLIC_URL=https://seu-app.replit.app

# Mostra as credenciais demo na tela de login (padrão: true)
DEMO_MODE=true
